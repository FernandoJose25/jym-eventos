# Firebase (cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jym-eventos.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jym-eventos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jym-eventos.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=898740479844
NEXT_PUBLIC_FIREBASE_APP_ID=1:898740479844:web:5b04cbddb041c498e97c71

# Firebase Admin (servidor — NUNCA con prefijo NEXT_PUBLIC_)
FIREBASE_ADMIN_PROJECT_ID=jym-eventos
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxx@jym-eventos.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (servidor — NUNCA con prefijo NEXT_PUBLIC_)
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# Cloudinary (cliente — solo el cloud name, no expone secretos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dvcmazqtp

# Groq AI
GROQ_API_KEY=gsk_...

# Google Analytics 4 (métricas de tráfico en Dashboard → Métricas)
# El ID de propiedad está en GA4 → Administrar → Detalles de la propiedad.
# La cuenta de servicio (FIREBASE_ADMIN_CLIENT_EMAIL de arriba) debe tener
# acceso de "Viewer" en esa misma propiedad (Administración de acceso).
GA4_PROPERTY_ID=123456789

# CASTREAM JYM — vinculación de Facebook (app de Meta en developers.facebook.com).
# Redirect URI válida a registrar en "Facebook Login for Business → Configuración":
#   https://administracion.jmdecoracionesyeventos.com/api/publisher/facebook/callback
# FACEBOOK_LOGIN_CONFIG_ID es opcional: si existe se usa la configuración de
# Login for Business; si no, se piden los permisos por scope.
# Los tokens de Meta se cifran con GOOGLE_PHOTOS_TOKEN_ENCRYPTION_KEY (misma clave AES).
# Datos de CASTREAM: proyecto Supabase propio (Settings → API). La service_role
# solo vive en el servidor: salta RLS para las tablas solo-backend.
CASTREAM_SUPABASE_URL=https://xxxx.supabase.co
CASTREAM_SUPABASE_SERVICE_ROLE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=

# CASTREAM — Fase 2 (importadores). Cliente OAuth del proyecto de Google Cloud de
# CASTREAM (no el de J&M); su URI de redirección autorizada debe incluir
#   https://administracion.jmdecoracionesyeventos.com/api/publisher/google-photos/callback
CASTREAM_GOOGLE_CLIENT_ID=
CASTREAM_GOOGLE_CLIENT_SECRET=
# Cuenta de Cloudinary propia de CASTREAM (galería importada; una carpeta por negocio).
CASTREAM_CLOUDINARY_CLOUD_NAME=
CASTREAM_CLOUDINARY_API_KEY=
CASTREAM_CLOUDINARY_API_SECRET=

# CASTREAM — Publicar desde el teléfono. Depósito temporal en Backblaze B2 (bucket
# privado, API S3): el teléfono sube con enlaces firmados y las redes descargan igual.
CASTREAM_B2_ENDPOINT=s3.us-east-005.backblazeb2.com
CASTREAM_B2_BUCKET=
CASTREAM_B2_KEY_ID=
CASTREAM_B2_APP_KEY=
# Secreto con el que el cron de Supabase llama a /api/publisher/tick cada minuto.
CASTREAM_CRON_SECRET=

# CASTREAM · TikTok (Login Kit + Content Posting API). Redirect registrado en TikTok:
# https://castream-app.vercel.app/api/tiktok/callback (la web de CASTREAM lo reenvía aquí).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# CASTREAM · chat de TikTok en vivo: el celular lo lee de Euler Stream con un pase temporal.
EULER_API_KEY=
EULER_ACCOUNT_ID=
# Relay propio (solo para transmitir a Facebook y TikTok a la vez), ej. rtmp://IP:1935
CASTREAM_RELAY_RTMP=
